{
    // .vscode/launch.json
    // VS Code > Run & Debug > add configuration > "C/C++: (gdb) Launch" template
    "version": "0.2.0",
    "configurations": [
      {
        "name": "(lldb) Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "/Users/fch/Python/MiniTNtk-Extension/MiniTNtk.out",
        "args": [
              "./",
              "0",
              "30",
              "0",
              "0",
              "1",
              "1",
              "1",
              "./SpiceNetlists/"
        ],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "lldb",
        "preLaunchTask": "C/C++: clang build active file"
      }
